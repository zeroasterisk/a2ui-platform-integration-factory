{
 "maxSourceLength": 32000,
 "cases": [
  {
   "id": "plain-text",
   "group": "wire",
   "text": "Hello",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "Hello"
    }
   ]
  },
  {
   "id": "closed-block-between-prose",
   "group": "wire",
   "text": "Pick one:\n<a2ui>\nroot = Text(\"hi\")\n</a2ui>\nThanks.",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "Pick one:\n"
    },
    {
     "kind": "a2ui",
     "offset": 10,
     "source": "root = Text(\"hi\")\n",
     "closed": true
    },
    {
     "kind": "markdown",
     "offset": 42,
     "markdown": "\nThanks."
    }
   ]
  },
  {
   "id": "streaming-unclosed-block",
   "group": "trust.streaming",
   "text": "Pick one:\n<a2ui>\nroot = Col",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "Pick one:\n"
    },
    {
     "kind": "a2ui",
     "offset": 10,
     "source": "root = Col",
     "closed": false
    }
   ]
  },
  {
   "id": "tag-inside-backtick-fence",
   "group": "trust.fenced",
   "text": "```\n<a2ui>\nroot = Text(\"x\")\n</a2ui>\n```",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "```\n<a2ui>\nroot = Text(\"x\")\n</a2ui>\n```"
    }
   ]
  },
  {
   "id": "tag-inside-tilde-fence",
   "group": "trust.fenced",
   "text": "~~~\n<a2ui>\nroot = Text(\"x\")\n</a2ui>\n~~~",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "~~~\n<a2ui>\nroot = Text(\"x\")\n</a2ui>\n~~~"
    }
   ]
  },
  {
   "id": "inline-prose-mention",
   "group": "trust.fenced",
   "text": "Use the <a2ui> tag to render.",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "Use the <a2ui> tag to render."
    }
   ]
  },
  {
   "id": "tilde-line-inside-backtick-fence",
   "group": "trust.fenced",
   "text": "```\n~~~\n<a2ui>\nx\n</a2ui>\n```",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "```\n~~~\n<a2ui>\nx\n</a2ui>\n```"
    }
   ]
  },
  {
   "id": "shorter-fence-inside-longer",
   "group": "trust.fenced",
   "text": "````md\n```\n<a2ui>\nx\n</a2ui>\n```\n````",
   "expect": [
    {
     "kind": "markdown",
     "offset": 0,
     "markdown": "````md\n```\n<a2ui>\nx\n</a2ui>\n```\n````"
    }
   ]
  },
  {
   "id": "source-on-opening-line",
   "group": "wire",
   "text": "<a2ui>root = Text(\"hi\")\n</a2ui>",
   "expect": [
    {
     "kind": "a2ui",
     "offset": 0,
     "source": "root = Text(\"hi\")\n",
     "closed": true
    }
   ]
  },
  {
   "id": "close-tag-in-express-string",
   "group": "wire",
   "text": "<a2ui>\nroot = Text(\"type </a2ui> to end\")\n</a2ui>\nDone.",
   "expect": [
    {
     "kind": "a2ui",
     "offset": 0,
     "source": "root = Text(\"type </a2ui> to end\")\n",
     "closed": true
    },
    {
     "kind": "markdown",
     "offset": 49,
     "markdown": "\nDone."
    }
   ]
  },
  {
   "id": "close-tag-in-triple-string-and-comment",
   "group": "wire",
   "text": "<a2ui>\n# </a2ui> in a comment\nroot = Text(\"\"\"a\n</a2ui>\nb\"\"\")\n</a2ui>",
   "expect": [
    {
     "kind": "a2ui",
     "offset": 0,
     "source": "# </a2ui> in a comment\nroot = Text(\"\"\"a\n</a2ui>\nb\"\"\")\n",
     "closed": true
    }
   ]
  },
  {
   "id": "close-tag-in-streaming-string",
   "group": "trust.streaming",
   "text": "<a2ui>\nroot = Text(\"</a2ui>",
   "expect": [
    {
     "kind": "a2ui",
     "offset": 0,
     "source": "root = Text(\"</a2ui>",
     "closed": false
    }
   ]
  },
  {
   "id": "two-surfaces-apart",
   "group": "wire",
   "text": "<a2ui>\na\n</a2ui>\nmid\n<a2ui>\nb\n</a2ui>",
   "expect": [
    {
     "kind": "a2ui",
     "offset": 0,
     "source": "a\n",
     "closed": true
    },
    {
     "kind": "markdown",
     "offset": 16,
     "markdown": "\nmid\n"
    },
    {
     "kind": "a2ui",
     "offset": 21,
     "source": "b\n",
     "closed": true
    }
   ]
  },
  {
   "id": "oversized-block-renders-as-code",
   "group": "trust.size",
   "text": {
    "repeat": "x",
    "count": 32001,
    "wrap": [
     "<a2ui>\n",
     "</a2ui>"
    ]
   },
   "expectKinds": [
    "markdown"
   ]
  }
 ]
}
